# Xoundra environment example
# Copy the pieces you need into local files. Do not commit real keys.
#
#   Expo app:        .env                  (project root)
#   Next.js web:     web/.env.local
#   Supabase funcs:  set secrets in the Supabase dashboard
#                    or `supabase secrets set`
#
# Only variables prefixed with EXPO_PUBLIC_ or NEXT_PUBLIC_ are visible
# to the client. Everything else stays on the server.

# ---------------------------------------------------------------------------
# Shared identity
# ---------------------------------------------------------------------------

APP_ENV=development
# development | staging | production

APP_NAME=Xoundra
ANDROID_PACKAGE=com.xoundra.app

# Final site origin. Used for Paystack callback URLs.
# Example: https://xoundra.com
PUBLIC_SITE_URL=https://YOUR-XOUNDRA-DOMAIN.example

# ---------------------------------------------------------------------------
# Supabase
# Safe in the Expo app and the website.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server only. Bypasses Row Level Security. Never put this in the app.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Paystack
# pk_test_ / pk_live_ may ship in the client.
# sk_test_ / sk_live_ must stay on the server. Paystack signs webhooks with it.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY

PAYSTACK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Where Paystack sends charge events. Point this at the Edge Function.
# Example: https://YOUR_PROJECT.supabase.co/functions/v1/paystack-webhook
PAYSTACK_WEBHOOK_URL=https://mmgezkeemyjxluxcshaz.supabase.co/functions/v1/paystack-webhook

# Return page after checkout. Sent on each payment. Paste it in Paystack only if the dashboard asks for a callback URL.
PAYSTACK_CALLBACK_URL=https://mmgezkeemyjxluxcshaz.supabase.co/functions/v1/paystack-callback

# NGN plans exist. USD plan codes stay empty until Paystack enables USD for this merchant.
PAYSTACK_PLAN_PREMIUM_MONTHLY_NGN=PLN_v9kai01dhpq734y
PAYSTACK_PLAN_PREMIUM_ANNUAL_NGN=PLN_wyfygk070h6ifgv
PAYSTACK_PLAN_PREMIUM_MONTHLY_USD=
PAYSTACK_PLAN_PREMIUM_ANNUAL_USD=

# ---------------------------------------------------------------------------
# Currency
# Charge currencies must be enabled on the Paystack account.
# Display currencies can be wider; those prices are approximate.
# ---------------------------------------------------------------------------

CHARGE_CURRENCIES=NGN,USD
DEFAULT_CHARGE_CURRENCY=NGN
DEFAULT_COUNTRY=NG
FX_RATE_PROVIDER_URL=https://YOUR_FX_SOURCE.example
FX_RATE_PROVIDER_KEY=YOUR_FX_KEY

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------

STORAGE_BUCKET_AUDIO=track-audio
STORAGE_BUCKET_ARTWORK=artwork
STORAGE_BUCKET_EVIDENCE=artist-evidence
MEDIA_SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# AI � OpenRouter
# The key stays on the server. The app must not call OpenRouter directly.
# Start with the lite model. Switch to the fallback if replies leave the catalogue.
# ---------------------------------------------------------------------------

OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://YOUR-XOUNDRA-DOMAIN.example
OPENROUTER_APP_NAME=Xoundra
AI_MONTHLY_BUDGET_USD=50
AI_USER_DAILY_REQUEST_LIMIT=30
SPEECH_TO_TEXT_API_KEY=YOUR_STT_KEY
TEXT_TO_SPEECH_API_KEY=YOUR_TTS_KEY

# ---------------------------------------------------------------------------
# Observability (optional in development)
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SENTRY_DSN=https://YOUR_PUBLIC_SENTRY_DSN
SENTRY_DSN=https://YOUR_SERVER_SENTRY_DSN
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# ---------------------------------------------------------------------------
# What must never go in the mobile app
# ---------------------------------------------------------------------------
#
# SUPABASE_SERVICE_ROLE_KEY
# PAYSTACK_SECRET_KEY
# SUPABASE_DB_URL
# OPENROUTER_API_KEY
# SPEECH_TO_TEXT_API_KEY
# TEXT_TO_SPEECH_API_KEY
# SENTRY_AUTH_TOKEN
# FX_RATE_PROVIDER_KEY
# SMTP_APP_PASSWORD

# ---------------------------------------------------------------------------
# Account email
# Gmail app password for xoundra.support@gmail.com.
# Set this as a Supabase Edge Function secret named SMTP_APP_PASSWORD.
# Never put it in the Expo app.
# ---------------------------------------------------------------------------

SMTP_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# ---------------------------------------------------------------------------
# Check-in emails (Good morning at 7:00 local, Good evening at 21:00 / 9pm local)
# Deployed as edge function `check-in`. Uses SMTP_APP_PASSWORD.
# Schedule an hourly cron with the secret, e.g.:
#   POST /functions/v1/check-in
#   Header: x-check-in-secret: <secret>
#   Body: { "action": "dispatch" }
# Reuses BILLING_CRON_SECRET if CHECK_IN_CRON_SECRET is unset.
# ---------------------------------------------------------------------------

CHECK_IN_CRON_SECRET=YOUR_CHECK_IN_CRON_SECRET
BILLING_CRON_SECRET=YOUR_BILLING_CRON_SECRET

# ---------------------------------------------------------------------------
# Ads (optional)
# Never put AdMob/AdSense account passwords in the app.
# Paste only public app IDs and ad unit / slot IDs after you create them
# in Google AdMob (Android/iOS) and AdSense (website).
# Expo Go cannot load native AdMob — use an EAS/dev build.
# ---------------------------------------------------------------------------

# Xoundra AdMob Android (public unit IDs):
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-9287775024440500~8194705195
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-9287775024440500/2961513637
EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-9287775024440500/5587676974
# Xoundra AdSense publisher (public):
EXPO_PUBLIC_ADSENSE_CLIENT=ca-pub-9287775024440500
EXPO_PUBLIC_ADSENSE_SLOT=xxxxxxxxxx
