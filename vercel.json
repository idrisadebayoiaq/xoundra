{
  "buildCommand": "npx expo export --platform web && node scripts/inject-adsense.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/app-ads.txt", "destination": "/app-ads.txt" },
    { "source": "/((?!ads\\.txt|app-ads\\.txt).*)", "destination": "/index.html" }
  ]
}
